{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "question",
    "revision",
    "status",
    "checks",
    "artifacts",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "success",
        "failed"
      ]
    },
    "checks": {
      "enum": [
        "passed",
        "pending",
        "failed"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "combo",
          "metrics"
        ],
        "properties": {
          "combo": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      }
    },
    "machine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "machine": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "gpu": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "env_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "randomness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "stochastic",
            "deterministic",
            "unknown"
          ]
        },
        "seeds": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "uniqueItems": true
        },
        "repeats": {
          "type": "integer",
          "minimum": 1
        },
        "design_ref": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
